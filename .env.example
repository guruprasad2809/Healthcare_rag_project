# ---------- API keys (fill these in; never commit your real .env) ----------
GEMINI_API_KEY=
QDRANT_API_KEY=
HF_TOKEN=

# ---------- Server ----------
PORT=3000
MAX_UPLOAD_MB=25

# ---------- LLM (Gemini) ----------
# "Gemini 4 Hydrogen" has no public API model ID yet. Put its ID here once Google
# releases it. Until then use a model that is available, e.g. gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024

# ---------- Embeddings (Qwen3-Embedding-0.6B, ONNX build for Node.js) ----------
EMBEDDING_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
EMBEDDING_DTYPE=q8
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8

# ---------- Reranker (BAAI/bge-reranker-v2-m3, ONNX build for Node.js) ----------
RERANKER_MODEL=onnx-community/bge-reranker-v2-m3-ONNX
RERANKER_DTYPE=q8
RERANKER_BATCH_SIZE=8
RERANKER_ENABLED=true

# ---------- Vector database (Qdrant) ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=healthcare_docs

# ---------- Chunking (semantic title-based) ----------
CHUNK_MAX_TOKENS=450
CHUNK_MIN_TOKENS=40
CHUNK_MERGE_TARGET_TOKENS=200
CHUNK_SEMANTIC_SPLIT=true

# ---------- Retrieval ----------
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=5
RERANK_MIN_SCORE=0.02

# ---------- Storage ----------
STORAGE_DIR=./storage
MODEL_CACHE_DIR=./storage/models
