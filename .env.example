# ---------- API keys (fill these in; never commit your real .env) ----------
GEMINI_API_KEY=
QDRANT_API_KEY=
HF_TOKEN=

# ---------- Server ----------
PORT=3000
MAX_UPLOAD_MB=25
# Login for the web page and API. Leave APP_PASSWORD blank on your own computer;
# always set it when the app is reachable from the internet.
APP_USERNAME=admin
APP_PASSWORD=

# ---------- LLM (Gemini) ----------
# "Gemini 4 Hydrogen" has no public API model ID yet. Put its ID here once Google
# releases it. gemini-3.5-flash-lite is fast and has a larger free daily allowance
# than the full Flash models (gemini-3.8-flash allows only 20 free requests a day).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024

# ---------- Embeddings (Qwen3-Embedding-0.6B, ONNX build for Node.js) ----------
EMBEDDING_MODEL=onnx-community/Qwen3-Embedding-0.6B-ONNX
EMBEDDING_DTYPE=q8
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=8

# ---------- Reranker (cross-encoder, ONNX build for Node.js) ----------
# Xenova/ms-marco-MiniLM-L-6-v2: small and fast on a CPU (about 1 second for 20 passages), English only.
# onnx-community/bge-reranker-v2-m3-ONNX: larger and multilingual, but about 10x slower on a CPU.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_DTYPE=q8
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=256
RERANKER_ENABLED=true

# ---------- Vector database (Qdrant) ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=healthcare_docs

# ---------- Chunking (semantic title-based) ----------
CHUNK_MAX_TOKENS=450
CHUNK_MIN_TOKENS=40
CHUNK_MERGE_TARGET_TOKENS=200
CHUNK_SEMANTIC_SPLIT=true

# ---------- Retrieval ----------
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=5
RERANK_MIN_SCORE=0

# ---------- Storage ----------
STORAGE_DIR=./storage
MODEL_CACHE_DIR=./storage/models

# ---------- Deployment (docker compose, see docs/DEPLOYMENT_GCP.md) ----------
# ":80" serves plain HTTP on the server's IP address. Put a domain name here
# (for example rag.example.com) to get HTTPS with an automatic certificate.
SITE_ADDRESS=:80
